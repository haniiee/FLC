# Database
DATABASE_URL=postgresql://flc:flc@localhost:5432/flc
DATABASE_URL_TEST=postgresql://flc:flc@localhost:5432/flc_test

# Storage: "s3" (local MinIO) or "supabase" (production)
STORAGE_DRIVER=s3

# S3 / MinIO (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=class-files

# Supabase Storage (required when STORAGE_DRIVER=supabase)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=...
# API_PUBLIC_URL=https://flc-api.onrender.com

# API
API_PORT=4000
JWT_SECRET=dev-only-change-me-flc-jwt
WEB_URL=http://localhost:3000

# Media (server-side audio processing)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Web — Supabase-native (preferred; no separate API host)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ... # server-only (Vercel / Next route handlers)
NEXT_PUBLIC_LANDING_AUDIO_URL=https://xxxx.supabase.co/storage/v1/object/public/landing/aida.mp4

# Mobile (Expo) — same Supabase project
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Legacy Fastify API (optional local fallback when NEXT_PUBLIC_SUPABASE_URL is unset)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Play Store or direct APK link for the Android button on the landing page
# Local default: put APK at apps/web/public/downloads/flc.apk
NEXT_PUBLIC_ANDROID_APP_URL=/downloads/flc.apk
