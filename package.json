{
  "name": "flc",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@app/api --filter=@app/web",
    "dev:phone": "tsx scripts/phone.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "prettier": "^3.4.2",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
