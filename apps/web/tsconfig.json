{
  "extends": "@app/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "@serwist/next/typings"],
    "lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "public/sw.js"]
}
